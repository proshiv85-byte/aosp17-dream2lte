From 9fdbbf84158ded8c9037140a59a9bf6e7b50f5d2 Mon Sep 17 00:00:00 2001
From: proshiv85-byte <248141944+proshiv85-byte@users.noreply.github.com>
Date: Fri, 2 Oct 2026 00:11:33 +0300
Subject: [PATCH] health: make filterPowerSupplyEvents BPF program optional

It uses bpf_skb_load_bytes, which is not available on legacy (4.4) kernels;
failing to load it made the vendor bpfloader abort and reboot the device.
HealthLoop already copes with the program being absent.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I7d4d85f8af39d913070700e410cc3eeb8a6530a5
---
 health/utils/libhealthloop/filterPowerSupplyEvents.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/health/utils/libhealthloop/filterPowerSupplyEvents.c b/health/utils/libhealthloop/filterPowerSupplyEvents.c
index 6f295c7..bfe5585 100644
--- a/health/utils/libhealthloop/filterPowerSupplyEvents.c
+++ b/health/utils/libhealthloop/filterPowerSupplyEvents.c
@@ -32,7 +32,9 @@ static long (*bpf_skb_load_bytes)(const struct __sk_buff* skb, int off, void* to
 #define HEX_POWER_SU 0x75735f7265776f70uLL  // "power_su"
 #define HEX_PPLY0    0x00000000796c7070uLL  // "pply\0" + null padding
 
-DEFINE_BPF_PROG("skfilter/power_supply", AID_ROOT, AID_SYSTEM, skfilter_power_supply)
+// Optional: needs bpf_skb_load_bytes (kernel 4.5+). HealthLoop falls back to
+// userspace filtering when the program is not loaded.
+DEFINE_OPTIONAL_BPF_PROG("skfilter/power_supply", AID_ROOT, AID_SYSTEM, skfilter_power_supply)
 (struct __sk_buff* skb) {
     // The first character matched is a '\0'. Starting right past the netlink message header
     // is fine since the SUBSYSTEM= text never occurs at the start, as the kernel always
