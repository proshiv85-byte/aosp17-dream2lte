From c3a42ad87be75411999f910508cb352cb5fb978e Mon Sep 17 00:00:00 2001
From: proshiv85-byte <248141944+proshiv85-byte@users.noreply.github.com>
Date: Thu, 1 Oct 2026 17:49:36 +0300
Subject: [PATCH] bootstrap: soft memory limit for soong_build on 30 GB build
 host

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: Ic9b99e5e9b21fe59b5d968053e77f4f9df29829e
---
 bootstrap/command.go | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/bootstrap/command.go b/bootstrap/command.go
index e5f6862..9b2cd33 100644
--- a/bootstrap/command.go
+++ b/bootstrap/command.go
@@ -70,6 +70,13 @@ var goModuleTypesAreWrapped = false
 func RunBlueprint(args Args, stopBefore StopBefore, ctx *blueprint.Context, config interface{}) ([]string, error) {
 	runtime.GOMAXPROCS(runtime.NumCPU())
 
+	// Local build-host tweak: this machine has 30 GB RAM. Without a limit the
+	// Go heap grows to ~2x the live set (~60 GB) and gets OOM-killed. A soft
+	// limit makes the GC collect more aggressively near it instead.
+	if !args.NoGC {
+		debug.SetMemoryLimit(36 << 30)
+	}
+
 	if args.NoGC {
 		debug.SetGCPercent(-1)
 	}
