diff --git a/src/com/android/wallpaper/util/WallpaperBlur.kt b/src/com/android/wallpaper/util/WallpaperBlur.kt
new file mode 100644
index 0000000..58e9756
--- /dev/null
+++ b/src/com/android/wallpaper/util/WallpaperBlur.kt
@@ -0,0 +1,122 @@
+/*
