+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.wallpaper.util
+
+import android.graphics.Bitmap
+import android.graphics.RenderEffect
+import android.graphics.Shader
+import kotlin.math.max
+import kotlin.math.roundToInt
+import kotlin.math.sqrt
+
+/**
+ * Blur applied to a static wallpaper when the user enables "Blur" while setting it.
+ *
+ * The strength is relative to the visible width of the wallpaper, so the preview (a small view)
+ * and the applied wallpaper (a full resolution bitmap) look the same.
+ */
+object WallpaperBlur {
+
+    /** Gaussian sigma as a fraction of the visible wallpaper width. */
+    private const val SIGMA_FRACTION = 0.035f
+
+    private const val BOX_RADIUS = 4
+    private const val BOX_PASSES = 3
+
+    /** Sigma of [BOX_PASSES] box blurs of [BOX_RADIUS], which approximate a gaussian. */
+    private val BOX_SIGMA =
+        sqrt(BOX_PASSES * ((2 * BOX_RADIUS + 1) * (2 * BOX_RADIUS + 1) - 1) / 12f)
+
+    /** Blur for a preview view that shows the whole visible wallpaper across [viewWidth]. */
+    fun createPreviewEffect(viewWidth: Int): RenderEffect {
+        // RenderEffect takes a radius; Skia converts it to sigma = 0.57735 * radius + 0.5.
+        val radius = max(1f, (SIGMA_FRACTION * viewWidth - 0.5f) / 0.57735f)
+        return RenderEffect.createBlurEffect(radius, radius, Shader.TileMode.CLAMP)
+    }
+
+    /**
+     * Returns a blurred copy of [source], the same size as [source].
+     *
+     * @param visibleWidth width in [source] pixels of the part shown on the screen.
+     */
+    fun blur(source: Bitmap, visibleWidth: Int): Bitmap {
+        val src =
+            if (source.config == Bitmap.Config.HARDWARE) {
+                source.copy(Bitmap.Config.ARGB_8888, /* isMutable= */ false)
+            } else {
+                source
+            }
+        val sigma = SIGMA_FRACTION * visibleWidth
+        // Blur at a reduced size where the wanted sigma is BOX_SIGMA pixels, then scale back up.
+        // The result is smooth, so the bilinear upscale does not show.
+        val scale = (BOX_SIGMA / sigma).coerceAtMost(1f)
+        val width = max(1, (src.width * scale).roundToInt())
+        val height = max(1, (src.height * scale).roundToInt())
+
+        // Halve with filtering first, so large downscales average pixels instead of skipping them.
+        var small = src
+        while (small.width / 2 >= width && small.height / 2 >= height) {
+            small = Bitmap.createScaledBitmap(small, small.width / 2, small.height / 2, true)
+        }
+        small = Bitmap.createScaledBitmap(small, width, height, true)
+
+        val pixels = IntArray(width * height)
+        val temp = IntArray(width * height)
+        small.getPixels(pixels, 0, width, 0, 0, width, height)
+        repeat(BOX_PASSES) {
+            boxBlur(pixels, temp, width, height, horizontal = true)
+            boxBlur(temp, pixels, width, height, horizontal = false)
+        }
+        val blurred = Bitmap.createBitmap(pixels, width, height, Bitmap.Config.ARGB_8888)
+        return Bitmap.createScaledBitmap(blurred, src.width, src.height, true)
+    }
+
+    /** One box blur pass along rows or columns, clamping at the edges. */
+    private fun boxBlur(src: IntArray, dst: IntArray, width: Int, height: Int, horizontal: Boolean) {
+        val lines = if (horizontal) height else width
+        val length = if (horizontal) width else height
+        val step = if (horizontal) 1 else width
+        val window = 2 * BOX_RADIUS + 1
+        for (line in 0 until lines) {
+            val start = if (horizontal) line * width else line
+            var a = 0
+            var r = 0
+            var g = 0
+            var b = 0
+            for (i in -BOX_RADIUS..BOX_RADIUS) {
+                val p = src[start + i.coerceIn(0, length - 1) * step]
+                a += p ushr 24
+                r += (p shr 16) and 0xff
+                g += (p shr 8) and 0xff
+                b += p and 0xff
+            }
+            for (i in 0 until length) {
+                dst[start + i * step] =
+                    ((a / window) shl 24) or
+                        ((r / window) shl 16) or
+                        ((g / window) shl 8) or
+                        (b / window)
+                val outgoing = src[start + (i - BOX_RADIUS).coerceAtLeast(0) * step]
+                val incoming = src[start + (i + BOX_RADIUS + 1).coerceAtMost(length - 1) * step]
+                a += (incoming ushr 24) - (outgoing ushr 24)
+                r += ((incoming shr 16) and 0xff) - ((outgoing shr 16) and 0xff)
+                g += ((incoming shr 8) and 0xff) - ((outgoing shr 8) and 0xff)
+                b += (incoming and 0xff) - (outgoing and 0xff)
+            }
+        }
+    }
+}
